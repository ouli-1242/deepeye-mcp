# DeepEye 配置示例
# 复制本文件为 .env 并按需填写 API Key。

# 视觉后端提供者：openai / gemini / custom（三类均已实现可切换）
VISION_PROVIDER=openai

# ---------- OpenAI 兼容后端 ----------
# OpenAI API Key（必填，使用 OpenAI 或兼容服务时）
OPENAI_API_KEY=
# 模型名称
OPENAI_MODEL=gpt-5.6-luna
# 接口地址，留空则使用官方 https://api.openai.com/v1；可改为 Azure / 代理 / 兼容服务地址
OPENAI_BASE_URL=

# ---------- Gemini 后端（可用） ----------
# 使用 Google Gemini generateContent API，端点默认为
# https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ---------- 自定义 OpenAI 兼容后端（可用） ----------
# 用于 vLLM / Ollama / 通义 / 智谱等任意 OpenAI 兼容多模态服务。
# 切换到 custom 后端时 CUSTOM_BASE_URL 必填。
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=qwen-vl-max

# ---------- OCR 后端 ----------
# extract_text 工具实际使用的视觉后端：openai / gemini / custom
OCR_BACKEND=openai

# ---------- 性能优化 ----------
# 图片预处理：图片最大边长，超过则等比缩放并转 JPEG；0 表示禁用预处理
IMAGE_MAX_DIM=2048
# 是否开启视觉识别结果缓存（命中可避免重复调用后端）
CACHE_ENABLED=true
# 缓存最大条目数（LRU 淘汰最旧条目）
CACHE_MAX_SIZE=128
# 缓存存活秒数（TTL，过期视为未命中）
CACHE_TTL=3600

# ---------- 网络请求 ----------
# 视觉后端 HTTP 请求超时（秒）
REQUEST_TIMEOUT=120
# 失败重试次数（仅对网络/超时错误重试，不对 4xx 重试）
MAX_RETRIES=3
# 视觉模型返回的最大 token 数
MAX_TOKENS=4096
# 推理深度：low / medium / high；留空则不发送该参数（部分后端不支持）
REASONING_EFFORT=

# ---------- 图片 URL 下载 ----------
# 下载图片的最大字节数，超过则拒绝（防止内存耗尽）
MAX_IMAGE_BYTES=20971520
# 是否允许访问内网/保留地址（默认禁止，防止 SSRF；仅本地调试时设为 true）
ALLOW_PRIVATE_URLS=false
